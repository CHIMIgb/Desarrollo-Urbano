{
  "name": "urbanplan-3d",
  "version": "1.0.0",
  "description": "Editor 3D de planificación urbana con datos geoespaciales",
  "main": "server/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "start:dev": "node server/index.js",
    "lint": "eslint src/ server/",
    "lint:fix": "eslint --fix src/ server/",
    "format": "prettier --write \"src/**/*.js\" \"server/**/*.js\" \"styles/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.js\" \"server/**/*.js\" \"styles/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHIMIgb/Desarrollo-Urbano.git"
  },
  "keywords": [
    "urban-planning",
    "3d",
    "maplibre",
    "geospatial"
  ],
  "author": "CHIMIgb",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CHIMIgb/Desarrollo-Urbano/issues"
  },
  "homepage": "https://github.com/CHIMIgb/Desarrollo-Urbano#readme",
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "maplibre-gl": "^4.7.1",
    "osmtogeojson": "^3.0.0-beta.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vitest": "^4.1.6"
  }
}
